rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}
    match /users/{uid} {
      // Any signed-in user can read a profile (to see a partner's name)
      allow read: if request.auth != null;
      // Only you can write your own doc
      allow write: if request.auth != null && request.auth.uid == uid;
      // Accepting a request sets coupleId on the sender's doc too
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/pairRequests/$(uid + '_' + request.auth.uid));

      // users/{uid}/feelings/{id}, seeded at sign-up
      match /feelings/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // inviteCodes/{code} → { uid }
    match /inviteCodes/{code} {
      // Look up one code; listing all codes isn't allowed
      allow get: if request.auth != null;
      // Reserve a code only for yourself
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
    }

    // pairRequests/{fromUid}_{toUid}
    match /pairRequests/{id} {
      // Sender and receiver can see it, and decline/cancel it
      allow read, delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      // Send (or re-send): must be from you
      allow create, update: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
    }

    // couples/{coupleId} → { members: [uidA, uidB], createdAt }
    match /couples/{coupleId} {
      // Only the two members can read it
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;
      // Created by the accept batch; you must be one of the members
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;

      // True if the signed-in user is one of this couple's members
      function isMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
      }

      // couples/{coupleId}/moments/{momentId}, one doc per tap
      match /moments/{momentId} {
        // Both partners see the whole history
        allow read: if isMember();
        // Only send as yourself; no edits or deletes
        allow create: if isMember()
          && request.resource.data.fromUid == request.auth.uid;
      }

      // couples/{coupleId}/events/{eventId}, shared calendar dates
      match /events/{eventId} {
        // Either partner can see and delete any event
        allow read, delete: if isMember();
        // Only add as yourself
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
        // Either partner can edit; who added it and when stay the same
        allow update: if isMember()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

  }
}
